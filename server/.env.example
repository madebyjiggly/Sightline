# Copy this file to `.env` and fill in your Basiq sandbox key.
# Get one free at https://dashboard.basiq.io (Developers → API Keys).

# Your Basiq API key (already base64-encoded in the dashboard).
BASIQ_API_KEY=

# Filled in by `npm run seed` — the sandbox user whose data the app reads.
BASIQ_USER_ID=

# Sandbox test bank + credentials (Basiq's public test values — safe to use).
BASIQ_TEST_INSTITUTION=AU00000
BASIQ_TEST_LOGIN=gavinBelson
BASIQ_TEST_PASSWORD=hello

# Optional
PORT=4000
BASIQ_BASE_URL=https://au-api.basiq.io
